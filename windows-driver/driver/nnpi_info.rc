#include <winver.h>
#include "../include/nnpi_version.h"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION NNPI_DRIVER_VERSION_NUM
 PRODUCTVERSION NNPI_DRIVER_VERSION_NUM
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DRV
 FILESUBTYPE VFT2_DRV_SYSTEM
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "NNPI Community\0"
   VALUE "FileDescription", "NNPI PCIe Ethernet Driver\0"
   VALUE "FileVersion", NNPI_DRIVER_VERSION "\0"
   VALUE "InternalName", "nnpi_info\0"
   VALUE "OriginalFilename", "nnpi_info.sys\0"
   VALUE "ProductName", "NNPI PCIe Ethernet\0"
   VALUE "ProductVersion", NNPI_DRIVER_VERSION "\0"
   VALUE "Comments", "Release " NNPI_RELEASE_VERSION "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
